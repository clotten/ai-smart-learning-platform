# ============================================
# 前端镜像：Nginx 托管 dist 静态文件
# 用法: docker build -f Dockerfile.frontend -t learn-frontend .
# ============================================
FROM nginx:alpine

# 拷贝前端构建产物 + Nginx 配置
COPY frontend/dist/ /usr/share/nginx/html/
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
